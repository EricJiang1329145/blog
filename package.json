	"private": true,
	"scripts": {
		"build": "node scripts/build-posts.mjs && next build && next-sitemap && opennextjs-cloudflare build --skipNextBuild",
		"build:opennext": "opennextjs-cloudflare build",
		"build:full": "node scripts/build-posts.mjs && next build && next-sitemap && opennextjs-cloudflare build --skipNextBuild",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "npm run lint && npm test -- --runInBand && npm run build",
		"deploy": "npm run build:full && opennextjs-cloudflare deploy",
		"dev": "node scripts/build-posts.mjs && next dev",
		"lint": "eslint src lib scripts --max-warnings=0",
		"test": "jest",
		"preview": "npm run build:full && opennextjs-cloudflare preview",
		"start": "next start",
		"generate-posts": "node scripts/build-posts.mjs"
	}
