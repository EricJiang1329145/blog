		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.2",
		"eslint-config-next": "^16.3.1",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"jest": "^30.2.0",
		"katex": "^0.16.28",
		"marked": "^17.0.1",
		"marked-katex-extension": "^5.1.6",
